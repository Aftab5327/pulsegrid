# Copy to .env and fill in. .env is gitignored; never commit a real token.
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC=digispace/sensors/+/telemetry
HISTORY_SIZE=120
CORS_ORIGINS=http://localhost:5173

# InfluxDB 2.x. Leave INFLUX_TOKEN blank to run without persistence: the live
# MQTT -> WebSocket path works either way, and history falls back to memory.
INFLUX_URL=http://localhost:8086
INFLUX_ORG=pulsegrid
INFLUX_BUCKET=telemetry
INFLUX_TOKEN=
